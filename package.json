{
  "name": "bpm-studio-pro",
  "productName": "BPM Studio Pro",
  "version": "0.2.6",
  "description": "BPM Studio Pro — определение темпа и тональности аудиофайлов",
  "main": "src/main.js",
  "author": "BPM Studio Pro",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bpmstudio.pro",
    "productName": "BPM Studio Pro",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BPM-Studio-Pro-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    },
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg"
        }
      ],
      "artifactName": "BPM-Studio-Pro-${version}-mac-${arch}.dmg"
    }
  }
}
